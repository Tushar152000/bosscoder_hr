rules_version = '2';

// All HR collections are server-mediated: the Next.js server uses the Admin SDK
// (which bypasses these rules), and the client SDK NEVER reads/writes these
// collections directly. We deny-all from the client to enforce that contract.
//
// IMPORTANT: This file applies to the *whole* Firebase project. Merge the
// `match /databases/{database}/documents` block with your existing
// bosscoder_website rules — do not replace them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /hr_users/{doc=**}            { allow read, write: if false; }
    match /hr_employees/{doc=**}        { allow read, write: if false; }
    match /hr_teams/{doc=**}            { allow read, write: if false; }
    match /hr_permissions/{doc=**}      { allow read, write: if false; }
    match /hr_review_cycles/{doc=**}    { allow read, write: if false; }
    match /hr_review_forms/{doc=**}     { allow read, write: if false; }
    match /hr_review_submissions/{doc=**} { allow read, write: if false; }
    match /hr_offer_letters/{doc=**}    { allow read, write: if false; }
    match /hr_settings/{doc=**}         { allow read, write: if false; }
    match /hr_offer_templates/{doc=**}  { allow read, write: if false; }
    match /hr_offer_letters/{doc=**}    { allow read, write: if false; }
    match /hr_notifications/{doc=**}    { allow read, write: if false; }
    match /hr_audit_logs/{doc=**}       { allow read, write: if false; }
  }
}
