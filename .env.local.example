# ──────────────────────────────────────────────────────────────────────────────
# Firebase — public client config (safe to commit, but kept here for parity).
# These values come from the existing `bosscoderplatformindia` Firebase project.
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAf-BvdyLfMNpms_0ahJAdQQrWsrdCMt9A
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bosscoderplatformindia.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bosscoderplatformindia
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bosscoderplatformindia.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=620375467743
NEXT_PUBLIC_FIREBASE_APP_ID=1:620375467743:web:9db91274abcc2d68e3ab6a

# ──────────────────────────────────────────────────────────────────────────────
# Firebase Admin — server-only. NEVER paste a real value into this file —
# this file is committed. Put the real secret in .env.local (git-ignored).
# Paste the service account JSON, base64-encoded:
#   cat service-account.json | base64
# (Use the same service account already in use for bosscoder_website.)
# ──────────────────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=

# ──────────────────────────────────────────────────────────────────────────────
# Field-level encryption (server-only). NEVER paste a real value into this file.
# Generate a 32-byte key, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this becomes the local DEK encrypted by Cloud KMS (envelope).
# ──────────────────────────────────────────────────────────────────────────────
HR_ENCRYPTION_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Auth domain restriction & founder bootstrap.
# Comma-separated list of allowed Google Workspace domains.
# ──────────────────────────────────────────────────────────────────────────────
ALLOWED_AUTH_DOMAINS=bosscoderacademy.com
FOUNDER_EMAILS=pavitra.lalwani@bosscoderacademy.com

# Set to "true" to skip the IAP/closed-system check during local dev.
# (IAP is only enforced in production deployment, never in dev.)
LOCAL_DEV=true

# ──────────────────────────────────────────────────────────────────────────────
# Email notifications (nodemailer + Gmail SMTP).
# Real value goes in .env.local — do not commit a real app password here.
# Generate one at: https://myaccount.google.com/apppasswords
# ──────────────────────────────────────────────────────────────────────────────
GMAIL_USER=updates@bosscoderacademy.com
GMAIL_APP_PASSWORD=

# Base URL used in outbound email links (https://hr.bosscoderacademy.com in prod).
APP_BASE_URL=http://localhost:3100
